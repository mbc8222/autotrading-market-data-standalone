# application-local.properties.example
#
# 개발(local) 프로파일 전용 접속정보 템플릿.
# 이 파일을 복사해 application-local.properties 로 만들고 실제 값을 채운다.
#   cp application-local.properties.example application-local.properties
#
# - 이 .example 만 git 추적 (실제 application-local.properties 는 .gitignore 로 제외).
# - 프로젝트 루트에 두면 IntelliJ 실행(작업 디렉토리=루트) 시 자동 로드된다.
#   src/main/resources 에 두지 말 것 — JAR 에 패키징되어 시크릿이 유출된다.
# - 운영(prod, Docker)은 이 파일을 쓰지 않는다. compose 의 env_file(deploy/market-data.env)이
#   환경변수로 주입한다.
#
# ★ 여기서 host 가 localhost 인 이유: local 프로파일은 앱이 컨테이너가 아니라 호스트에서 직접 뜨기 때문이다.
#   compose 의 postgres 는 기본적으로 호스트에 포트를 열지 않으므로, 호스트에서 bootRun 하려면
#   docker-compose.yml 의 postgres ports 주석을 풀어 127.0.0.1:5432 를 발행해야 한다.

# PostgreSQL
spring.datasource.url=jdbc:postgresql://localhost:5432/marketdata?currentSchema=marketdata
spring.datasource.username=marketdata
spring.datasource.password=your_password

# Flyway — 위 DataSource 공유, 스키마만 지정
spring.flyway.default-schema=marketdata
spring.flyway.schemas=marketdata
