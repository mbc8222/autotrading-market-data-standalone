# market-data.env.example — standalone 접속정보 템플릿 (compose env_file)
#
# 사용:
#   cp deploy/market-data.env.example deploy/market-data.env
#   # 아래 비밀번호 두 곳을 같은 값으로 바꾼다
#   docker compose up -d --build
#
# 이 .example 만 git 추적. 실제 deploy/market-data.env 는 .gitignore(*.env)로 제외 — 절대 커밋 금지.
# (KEY=VALUE 한 줄 형식. 따옴표 불필요, 값 안의 = 와 ? 는 그대로 둔다.)
#
# ★ host 가 "postgres" 인 이유: compose 가 서비스 이름을 DNS 로 풀어준다. 바꾸지 말 것.
#   (별도 인프라·공유망 설정이 필요 없는 이유이기도 하다.)

# ── PostgreSQL 컨테이너 초기화용 (첫 기동에만 쓰인다) ──
POSTGRES_DB=marketdata
POSTGRES_USER=marketdata
POSTGRES_PASSWORD=change_me

# ── 앱 접속용 — 위 세 값과 일치해야 한다 ──
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/marketdata?currentSchema=marketdata
SPRING_DATASOURCE_USERNAME=marketdata
SPRING_DATASOURCE_PASSWORD=change_me

# Flyway — 위 DataSource 공유, 스키마만 지정 (스키마가 없으면 Flyway 가 만든다)
SPRING_FLYWAY_DEFAULT_SCHEMA=marketdata
SPRING_FLYWAY_SCHEMAS=marketdata

# ── 수집 범위 (기본값은 application.properties) ──
# 풀북 원시는 일 11~24GB 이고 이 판에는 지우는 주체가 없다. 켤 거면 디스크 대책을 먼저 세울 것.
# COLLECT_DEPTH_ENABLED=false
# COLLECT_RAW_ENABLED=true
# COLLECT_SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt
